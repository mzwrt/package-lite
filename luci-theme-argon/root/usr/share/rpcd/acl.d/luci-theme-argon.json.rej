--- luci-theme-argon/root/usr/share/rpcd/acl.d/luci-theme-argon.json
+++ luci-theme-argon/root/usr/share/rpcd/acl.d/luci-theme-argon.json
@@ -2,7 +2,12 @@
     "luci-theme-argon": {
         "description": "Grant UCI access for luci-theme-argon",
         "read": {
-            "uci": [ "argon" ]
+            "uci": [ "argon" ],
+            "file": {
+                "/bin/cat /sys/class/thermal/thermal_zone*/temp": [ "exec" ],
+                "/bin/cat /sys/class/hwmon/hwmon*/temp1_input": [ "exec" ],
+                "/usr/bin/head -1 /proc/stat": [ "exec" ]
+            }
         }
     }
 }
